APP_NAME="Scalable Investment Research Agent"
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://research:research@postgres:5432/research
